{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "MED·Kit design tokens",
  "version": "2025.10",
  "description": "Every token set MED·Kit combines, in the order later sets win.",
  "sets": {
    "primitives": {
      "description": "Raw values.",
      "sources": [{"$ref": "primitives.json"}]
    },
    "semantic": {
      "description": "Roles that components read, with Forest values.",
      "sources": [{"$ref": "semantic.json"}]
    }
  },
  "modifiers": {
    "scheme": {
      "description": "Forest is the default on every device. Paper is the visitor's choice, or a nested section.",
      "contexts": {
        "forest": [],
        "paper": [{"$ref": "semantic.paper.json"}]
      },
      "default": "forest"
    },
    "contrast": {
      "description": "prefers-contrast: more. Promotes weak roles to stronger roles, so it holds in either theme.",
      "contexts": {
        "standard": [],
        "more": [
          {
            "color": {
              "text": {"muted": {"$value": "{color.text.default}"}},
              "border": {"default": {"$value": "{color.border.strong}"}}
            }
          }
        ]
      },
      "default": "standard"
    }
  },
  "resolutionOrder": [
    {"$ref": "#/sets/primitives"},
    {"$ref": "#/sets/semantic"},
    {"$ref": "#/modifiers/scheme"},
    {"$ref": "#/modifiers/contrast"}
  ]
}
