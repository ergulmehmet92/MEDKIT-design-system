{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Semantic tier: roles, as aliases only, with Forest values. semantic.paper.json overrides them for Paper. Names describe purpose and never mention a hue or theme. The forcedColors extension names the system colour each role uses in forced-colors mode.",
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{color.forest}",
        "$description": "Page and section background.",
        "$extensions": {
          "com.medkit.forcedColors": "Canvas"
        }
      },
      "subtle": {
        "$value": "{color.forest}",
        "$description": "Quieter areas within a page. Only differs from the default in Paper.",
        "$extensions": {
          "com.medkit.forcedColors": "Canvas"
        }
      }
    },
    "text": {
      "default": {
        "$value": "{color.off-white}",
        "$description": "Body and heading text. 4.5:1 or more on every surface.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "muted": {
        "$value": "{color.grey-300}",
        "$description": "Labels and secondary text. 4.5:1 or more on every surface.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "accent": {
        "$value": "{color.honey}",
        "$description": "Emphasised text. 4.5:1 or more on every surface.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      }
    },
    "border": {
      "default": {
        "$value": "{color.hairline-pale}",
        "$description": "Decorative rules and grid lines. Exempt from contrast minimums, so never a control's only boundary.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "strong": {
        "$value": "{color.grey-300}",
        "$description": "Control boundaries. 3:1 or more on every surface.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "focus": {
        "$value": "{color.honey}",
        "$description": "Focus indicator. 3:1 or more on every surface.",
        "$extensions": {
          "com.medkit.forcedColors": "Highlight"
        }
      }
    },
    "status": {
      "live": {
        "$value": "{color.signal-green}",
        "$description": "Live lamp. Graphics only, never as text. 3:1 or more on every surface.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "stale": {
        "$value": "{color.signal-orange}",
        "$description": "Stale lamp. Graphics only, never as text. 3:1 or more on every surface.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "failed": {
        "$value": "{color.signal-red}",
        "$description": "Failed lamp. Graphics only, never as text. 3:1 or more on every surface.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      }
    },
    "ambient": {
      "base": {
        "$value": "{color.forest}",
        "$description": "The light's darkest colour, and its fallback's edge.",
        "$extensions": {
          "com.medkit.forcedColors": "Canvas"
        }
      },
      "mid": {
        "$value": "{color.ambient-forest-mid}",
        "$description": "The light's middle tone.",
        "$extensions": {
          "com.medkit.forcedColors": "Canvas"
        }
      },
      "high": {
        "$value": "{color.ambient-forest-high}",
        "$description": "The light's brightest colour.",
        "$extensions": {
          "com.medkit.forcedColors": "Canvas"
        }
      },
      "accent": {
        "$value": "{color.ambient-forest-accent}",
        "$description": "Pools of colour within the light.",
        "$extensions": {
          "com.medkit.forcedColors": "Canvas"
        }
      }
    },
    "material": {
      "specular": {
        "$value": "{color.highlight}",
        "$description": "Highlights on glass edges. Decorative, so exempt from contrast minimums.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "glow": {
        "$value": "{color.honey}",
        "$description": "Light spilling past an opaque control. Decorative.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "shade": {
        "$value": "{color.forest-deep}",
        "$description": "Contact shadow and occlusion. Decorative.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      }
    },
    "action": {
      "background": {
        "primary": {
          "default": {
            "$value": "{color.off-white}",
            "$description": "Primary action fill at rest.",
            "$extensions": {
              "com.medkit.forcedColors": "ButtonFace"
            }
          },
          "lit": {
            "$value": "{color.highlight}",
            "$description": "The side of a primary action facing the light.",
            "$extensions": {
              "com.medkit.forcedColors": "ButtonFace"
            }
          },
          "far": {
            "$value": "{color.beige}",
            "$description": "The side of a primary action away from the light.",
            "$extensions": {
              "com.medkit.forcedColors": "ButtonFace"
            }
          }
        }
      },
      "foreground": {
        "primary": {
          "default": {
            "$value": "{color.forest}",
            "$description": "Label on every primary action fill. 4.5:1 or more.",
            "$extensions": {
              "com.medkit.forcedColors": "ButtonText"
            }
          }
        }
      }
    },
    "dataviz": {
      "category": {
        "1": {
          "$value": "{color.viz.amber.forest}",
          "$description": "Categorical slots, assigned in this order and never cycled. Marks only, never text. 3:1 or more on every surface.",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "2": {
          "$value": "{color.viz.teal.forest}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "3": {
          "$value": "{color.viz.iris.forest}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "4": {
          "$value": "{color.viz.rose.forest}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "5": {
          "$value": "{color.viz.blue.forest}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "6": {
          "$value": "{color.viz.olive.forest}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "7": {
          "$value": "{color.viz.orchid.forest}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "8": {
          "$value": "{color.viz.jade.forest}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        }
      },
      "sequential": {
        "100": {
          "$value": "{color.viz.amber-scale.forest.100}",
          "$description": "Magnitude, one hue. 100 sits nearest the surface.",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "200": {
          "$value": "{color.viz.amber-scale.forest.200}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "300": {
          "$value": "{color.viz.amber-scale.forest.300}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "400": {
          "$value": "{color.viz.amber-scale.forest.400}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "500": {
          "$value": "{color.viz.amber-scale.forest.500}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "600": {
          "$value": "{color.viz.amber-scale.forest.600}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "700": {
          "$value": "{color.viz.amber-scale.forest.700}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        }
      },
      "sequential-alt": {
        "100": {
          "$value": "{color.viz.blue-scale.forest.100}",
          "$description": "A second magnitude scale in the same view.",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "200": {
          "$value": "{color.viz.blue-scale.forest.200}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "300": {
          "$value": "{color.viz.blue-scale.forest.300}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "400": {
          "$value": "{color.viz.blue-scale.forest.400}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "500": {
          "$value": "{color.viz.blue-scale.forest.500}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "600": {
          "$value": "{color.viz.blue-scale.forest.600}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "700": {
          "$value": "{color.viz.blue-scale.forest.700}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        }
      },
      "diverging": {
        "below-3": {
          "$value": "{color.viz.blue-amber.forest.100}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "below-2": {
          "$value": "{color.viz.blue-amber.forest.200}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "below-1": {
          "$value": "{color.viz.blue-amber.forest.300}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "mid": {
          "$value": "{color.viz.blue-amber.forest.400}",
          "$description": "Polarity. The midpoint is a warm neutral and means nothing.",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "above-1": {
          "$value": "{color.viz.blue-amber.forest.500}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "above-2": {
          "$value": "{color.viz.blue-amber.forest.600}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "above-3": {
          "$value": "{color.viz.blue-amber.forest.700}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        }
      },
      "lead": {
        "$value": "{color.off-white}",
        "$description": "The series or metric a view is about. White on Forest, ink on Paper.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "context": {
        "$value": "{color.grey-300}",
        "$description": "Benchmarks and comparisons.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "up": {
        "$value": "{color.viz.up.forest}",
        "$description": "Gains and rises. Always with a sign or an arrow.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "down": {
        "$value": "{color.viz.down.forest}",
        "$description": "Losses and falls. Always with a sign or an arrow.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "accent": {
        "$value": "{color.honey}",
        "$description": "The one accent: forecasts, a highlighted part, now.",
        "$extensions": {
          "com.medkit.forcedColors": "CanvasText"
        }
      },
      "neutral": {
        "1": {
          "$value": "{color.viz.neutral.forest.1}",
          "$description": "Parts of a whole that aren't the story, strongest first.",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "2": {
          "$value": "{color.viz.neutral.forest.2}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "3": {
          "$value": "{color.viz.neutral.forest.3}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        },
        "4": {
          "$value": "{color.viz.neutral.forest.4}",
          "$extensions": {
            "com.medkit.forcedColors": "CanvasText"
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "{font.family.sans}",
        "$description": "Headlines and running text."
      },
      "label": {
        "$value": "{font.family.mono}",
        "$description": "Uppercase labels and metadata."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": "{font.weight.regular}"
      },
      "strong": {
        "$value": "{font.weight.bold}",
        "$description": "Poster moments and emphasis."
      },
      "label": {
        "$value": "{font.weight.regular}"
      }
    },
    "size": {
      "$type": "dimension",
      "label": {
        "$value": "{font.size.100}"
      },
      "body": {
        "$value": "{font.size.200}"
      },
      "lead": {
        "$value": "{font.size.300}"
      },
      "title": {
        "$value": "{font.size.400}"
      },
      "subheading": {
        "$value": "{font.size.500}"
      },
      "standalone": {
        "$value": "{font.size.300}",
        "$description": "Links and actions that stand on their own, such as ArrowLink."
      }
    }
  },
  "line-height": {
    "$type": "number",
    "tight": {
      "$value": "{leading.100}",
      "$description": "Display and heading sizes."
    },
    "snug": {
      "$value": "{leading.200}",
      "$description": "Titles."
    },
    "body": {
      "$value": "{leading.300}",
      "$description": "Running text and labels."
    },
    "poster": {
      "$value": "{leading.084}",
      "$description": "Poster moments only."
    }
  },
  "gap": {
    "$type": "dimension",
    "sm": {
      "$value": "{space.2}"
    },
    "md": {
      "$value": "{space.4}"
    },
    "lg": {
      "$value": "{space.8}"
    },
    "xl": {
      "$value": "{space.16}"
    },
    "section": {
      "$value": "{space.12}",
      "$description": "Between the blocks of a section."
    }
  },
  "inset": {
    "$type": "dimension",
    "sm": {
      "$value": "{space.2}"
    },
    "md": {
      "$value": "{space.4}"
    },
    "lg": {
      "$value": "{space.8}"
    },
    "control": {
      "$value": "{space.6}",
      "$description": "Sides of a control with a text label."
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$value": "{space.12}",
      "$description": "Height of a control, and the width of an icon button."
    },
    "row": {
      "$value": "{space.14}",
      "$description": "Height of a table row."
    },
    "column": {
      "$value": "{size.180}",
      "$description": "Narrowest column in an auto-fit grid, such as a metric row."
    },
    "chart": {
      "$value": "{size.520}",
      "$description": "Plot height for one chart, without its axis labels."
    }
  },
  "glass": {
    "brightness": {
      "$type": "number",
      "$value": "{brightness.dim}",
      "$description": "How much a glass control dims the light behind it, so its label stays readable."
    }
  },
  "radius": {
    "$type": "dimension",
    "default": {
      "$value": "{radius.none}",
      "$description": "Surfaces stay square."
    },
    "control": {
      "$value": "{radius.full}",
      "$description": "Controls are stadiums: a rectangle with circular ends."
    },
    "circle": {
      "$value": "{radius.full}",
      "$description": "Circles only."
    }
  },
  "border-width": {
    "$type": "dimension",
    "default": {
      "$value": "{stroke.hairline}"
    },
    "focus": {
      "$value": "{stroke.focus}"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "interaction": {
        "$value": "{time.150}",
        "$description": "Hover and press."
      },
      "theme-text": {
        "$value": "{time.1400}",
        "$description": "Text and surfaces changing theme."
      },
      "theme-light": {
        "$value": "{time.1800}",
        "$description": "Dawn: the light changing theme."
      },
      "chart-reveal": {
        "$value": "{time.1400}",
        "$description": "A chart drawing itself in, once."
      },
      "chart-change": {
        "$value": "{time.600}",
        "$description": "A chart moving to a new range or new data."
      }
    },
    "delay": {
      "$type": "duration",
      "theme-text": {
        "$value": "{time.200}",
        "$description": "Text follows the light by this much."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "default": {
        "$value": "{curve.out-expo}"
      }
    }
  },
  "dataviz": {
    "tint": {
      "$type": "number",
      "$value": "{mix.044}",
      "$description": "How much of a series colour a large filled area keeps when mixed into the surface. Higher on Forest, where the surface is dark."
    }
  }
}
