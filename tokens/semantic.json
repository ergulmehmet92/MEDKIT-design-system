{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Semantic tier: roles, as aliases only, with Forest values. semantic.paper.json overrides them for Paper. Names describe purpose and never mention a hue or theme. The forcedColors extension names the system colour each role uses in forced-colors mode.",
  "color": {
    "$type": "color",
    "surface": {
      "default": {"$value": "{color.forest}", "$description": "Page and section background.", "$extensions": {"com.medkit.forcedColors": "Canvas"}},
      "subtle": {"$value": "{color.forest}", "$description": "Quieter areas within a page. Only differs from the default in Paper.", "$extensions": {"com.medkit.forcedColors": "Canvas"}}
    },
    "text": {
      "default": {"$value": "{color.off-white}", "$description": "Body and heading text. 4.5:1 or more on every surface.", "$extensions": {"com.medkit.forcedColors": "CanvasText"}},
      "muted": {"$value": "{color.grey-300}", "$description": "Labels and secondary text. 4.5:1 or more on every surface.", "$extensions": {"com.medkit.forcedColors": "CanvasText"}},
      "accent": {"$value": "{color.honey}", "$description": "Emphasised text. 4.5:1 or more on every surface.", "$extensions": {"com.medkit.forcedColors": "CanvasText"}}
    },
    "border": {
      "default": {"$value": "{color.hairline-pale}", "$description": "Decorative rules and grid lines. Exempt from contrast minimums, so never a control's only boundary.", "$extensions": {"com.medkit.forcedColors": "CanvasText"}},
      "strong": {"$value": "{color.grey-300}", "$description": "Control boundaries. 3:1 or more on every surface.", "$extensions": {"com.medkit.forcedColors": "CanvasText"}},
      "focus": {"$value": "{color.honey}", "$description": "Focus indicator. 3:1 or more on every surface.", "$extensions": {"com.medkit.forcedColors": "Highlight"}}
    },
    "status": {
      "live": {"$value": "{color.signal-green}", "$description": "Live lamp. Graphics only, never as text. 3:1 or more on every surface.", "$extensions": {"com.medkit.forcedColors": "CanvasText"}},
      "stale": {"$value": "{color.signal-orange}", "$description": "Stale lamp. Graphics only, never as text. 3:1 or more on every surface.", "$extensions": {"com.medkit.forcedColors": "CanvasText"}},
      "failed": {"$value": "{color.signal-red}", "$description": "Failed lamp. Graphics only, never as text. 3:1 or more on every surface.", "$extensions": {"com.medkit.forcedColors": "CanvasText"}}
    },
    "action": {
      "background": {
        "primary": {
          "default": {"$value": "{color.off-white}", "$description": "Primary action fill at rest.", "$extensions": {"com.medkit.forcedColors": "ButtonFace"}},
          "hover": {"$value": "{color.beige}", "$description": "Primary action fill on hover.", "$extensions": {"com.medkit.forcedColors": "ButtonFace"}},
          "active": {"$value": "{color.sand}", "$description": "Primary action fill while pressed.", "$extensions": {"com.medkit.forcedColors": "ButtonFace"}}
        }
      },
      "foreground": {
        "primary": {
          "default": {"$value": "{color.forest}", "$description": "Label on every primary action fill. 4.5:1 or more.", "$extensions": {"com.medkit.forcedColors": "ButtonText"}}
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {"$value": "{font.family.sans}", "$description": "Headlines and running text."},
      "label": {"$value": "{font.family.mono}", "$description": "Uppercase labels and metadata."}
    },
    "weight": {
      "$type": "fontWeight",
      "body": {"$value": "{font.weight.regular}"},
      "strong": {"$value": "{font.weight.bold}", "$description": "Poster moments and emphasis."},
      "label": {"$value": "{font.weight.regular}"}
    },
    "size": {
      "$type": "dimension",
      "label": {"$value": "{font.size.100}"},
      "body": {"$value": "{font.size.200}"},
      "lead": {"$value": "{font.size.300}"},
      "title": {"$value": "{font.size.400}"},
      "subheading": {"$value": "{font.size.500}"}
    }
  },
  "line-height": {
    "$type": "number",
    "tight": {"$value": "{leading.100}", "$description": "Display and heading sizes."},
    "snug": {"$value": "{leading.200}", "$description": "Titles."},
    "body": {"$value": "{leading.300}", "$description": "Running text and labels."}
  },
  "gap": {
    "$type": "dimension",
    "sm": {"$value": "{space.2}"},
    "md": {"$value": "{space.4}"},
    "lg": {"$value": "{space.8}"},
    "xl": {"$value": "{space.16}"}
  },
  "inset": {
    "$type": "dimension",
    "sm": {"$value": "{space.2}"},
    "md": {"$value": "{space.4}"},
    "lg": {"$value": "{space.8}"}
  },
  "radius": {
    "$type": "dimension",
    "default": {"$value": "{radius.none}", "$description": "Everything is square unless it's a circle."},
    "circle": {"$value": "{radius.full}", "$description": "Circles only."}
  },
  "border-width": {
    "$type": "dimension",
    "default": {"$value": "{stroke.hairline}"},
    "focus": {"$value": "{stroke.focus}"}
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "interaction": {"$value": "{time.150}", "$description": "Hover and press."},
      "theme-text": {"$value": "{time.1400}", "$description": "Text and surfaces changing theme."},
      "theme-light": {"$value": "{time.1800}", "$description": "Dawn: the light changing theme."}
    },
    "delay": {
      "$type": "duration",
      "theme-text": {"$value": "{time.200}", "$description": "Text follows the light by this much."}
    },
    "easing": {
      "$type": "cubicBezier",
      "default": {"$value": "{curve.out-expo}"}
    }
  }
}
