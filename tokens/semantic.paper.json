{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Paper overrides for the semantic tier. Only roles that change.",
  "color": {
    "surface": {
      "default": {"$value": "{color.off-white}"},
      "subtle": {"$value": "{color.beige}"}
    },
    "text": {
      "default": {"$value": "{color.forest}"},
      "muted": {"$value": "{color.grey-600}"},
      "accent": {"$value": "{color.honey-deep}"}
    },
    "border": {
      "default": {"$value": "{color.hairline-deep}"},
      "strong": {"$value": "{color.grey-600}"},
      "focus": {"$value": "{color.honey-deep}"}
    },
    "status": {
      "live": {"$value": "{color.signal-green-deep}"},
      "stale": {"$value": "{color.signal-orange-deep}"},
      "failed": {"$value": "{color.signal-red-deep}"}
    },
    "ambient": {
      "base": {"$value": "{color.ambient-paper-base}"},
      "mid": {"$value": "{color.sand}"},
      "high": {"$value": "{color.ambient-paper-high}"},
      "accent": {"$value": "{color.ambient-paper-accent}"}
    },
    "material": {
      "shade": {"$value": "{color.honey-deep}"}
    },
    "action": {
      "background": {
        "primary": {
          "default": {"$value": "{color.forest}"},
          "lit": {"$value": "{color.hunter}"},
          "far": {"$value": "{color.forest-deep}"}
        }
      },
      "foreground": {
        "primary": {
          "default": {"$value": "{color.off-white}"}
        }
      }
    },
    "dataviz": {
      "lead": {"$value": "{color.forest}"},
      "context": {"$value": "{color.grey-600}"},
      "up": {"$value": "{color.viz.up.paper}"},
      "down": {"$value": "{color.viz.down.paper}"},
      "accent": {"$value": "{color.viz.amber.paper}"},
      "neutral": {"1": {"$value": "{color.viz.neutral.paper.1}"}, "2": {"$value": "{color.viz.neutral.paper.2}"}, "3": {"$value": "{color.viz.neutral.paper.3}"}, "4": {"$value": "{color.viz.neutral.paper.4}"}},
      "category": {"1": {"$value": "{color.viz.amber.paper}"}, "2": {"$value": "{color.viz.teal.paper}"}, "3": {"$value": "{color.viz.iris.paper}"}, "4": {"$value": "{color.viz.rose.paper}"}, "5": {"$value": "{color.viz.blue.paper}"}, "6": {"$value": "{color.viz.olive.paper}"}, "7": {"$value": "{color.viz.orchid.paper}"}, "8": {"$value": "{color.viz.jade.paper}"}},
      "sequential": {"100": {"$value": "{color.viz.amber-scale.paper.100}"}, "200": {"$value": "{color.viz.amber-scale.paper.200}"}, "300": {"$value": "{color.viz.amber-scale.paper.300}"}, "400": {"$value": "{color.viz.amber-scale.paper.400}"}, "500": {"$value": "{color.viz.amber-scale.paper.500}"}, "600": {"$value": "{color.viz.amber-scale.paper.600}"}, "700": {"$value": "{color.viz.amber-scale.paper.700}"}},
      "sequential-alt": {"100": {"$value": "{color.viz.blue-scale.paper.100}"}, "200": {"$value": "{color.viz.blue-scale.paper.200}"}, "300": {"$value": "{color.viz.blue-scale.paper.300}"}, "400": {"$value": "{color.viz.blue-scale.paper.400}"}, "500": {"$value": "{color.viz.blue-scale.paper.500}"}, "600": {"$value": "{color.viz.blue-scale.paper.600}"}, "700": {"$value": "{color.viz.blue-scale.paper.700}"}},
      "diverging": {"below-3": {"$value": "{color.viz.blue-amber.paper.100}"}, "below-2": {"$value": "{color.viz.blue-amber.paper.200}"}, "below-1": {"$value": "{color.viz.blue-amber.paper.300}"}, "mid": {"$value": "{color.viz.blue-amber.paper.400}"}, "above-1": {"$value": "{color.viz.blue-amber.paper.500}"}, "above-2": {"$value": "{color.viz.blue-amber.paper.600}"}, "above-3": {"$value": "{color.viz.blue-amber.paper.700}"}}
    }
  },
  "glass": {
    "brightness": {"$value": "{brightness.full}"}
  },
  "dataviz": {
    "tint": {"$type": "number", "$value": "{mix.030}"}
  }
}
