{
  "name": "@ergulmehmet92/medkit",
  "version": "2.0.0-alpha.0",
  "description": "MED\u00b7Kit: the Mehmet Ergul Design Kit. Design tokens and React components.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./components/index.ts",
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "components/index.ts",
    "components/atoms",
    "components/molecules",
    "components/organisms",
    "dist",
    "fonts",
    "LICENSE",
    "!components/**/*.test.tsx",
    "!components/**/*.stories.tsx",
    "!components/**/*.spec.md"
  ],
  "scripts": {
    "tokens": "node style-dictionary.config.mjs",
    "validate": "python3 scripts/validate_tokens.py --resolver tokens/tokens.resolver.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contrast": "node scripts/contrast.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.5",
    "style-dictionary": "^5.8.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
