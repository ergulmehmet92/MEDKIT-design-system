{
  "name": "@ergulmehmet92/medkit",
  "version": "2.0.0-alpha.0",
  "description": "MED\u00b7Kit: the Mehmet Ergul Design Kit. Design tokens and React components.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./components/index.ts",
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "components/index.ts",
    "components/atoms",
    "components/molecules",
    "components/organisms",
    "dist",
    "fonts",
    "LICENSE"
  ],
  "scripts": {
    "tokens": "node style-dictionary.config.mjs",
    "validate": "python3 scripts/validate_tokens.py --resolver tokens/tokens.resolver.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contrast": "node scripts/contrast.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "style-dictionary": "^5.8.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  }
}
